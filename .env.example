# FOLIO Postgres (DigitalOcean - read-only queries)
FOLIO_PG_HOST=reportingtest-ldlite-load-do-user-23434080-0.k.db.ondigitalocean.com
FOLIO_PG_PORT=25060
FOLIO_PG_DB=ldplite
FOLIO_PG_USER=
FOLIO_PG_PASS=

# Local MySQL (app state - saved queries, audit log)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=folio_reports
MYSQL_USER=folio_app
MYSQL_PASSWORD=folio_app_pass
MYSQL_PORT=3307

# Gemini API (optional - for NL->SQL feature)
GEMINI_API_KEY=

# Ports (Docker dev only)
NGINX_PORT=8080

# ── Production settings (ignored in Docker dev) ──────────────────

# Base path when deployed under a subpath (e.g. /folio-report-explorer)
# Leave empty or unset for root deployment
# APP_BASE_PATH=/folio-report-explorer
# VITE_BASE_PATH=/folio-report-explorer/

# MySQL connection for bare-metal deploy (non-Docker)
# MYSQL_HOST=localhost

# Yii2 environment
# YII_DEBUG=false
# YII_ENV=prod

# Cookie signing key — generate a random string for production
# COOKIE_VALIDATION_KEY=change-me-to-a-random-string

# JWT secret for auth tokens — generate a long random string
# JWT_SECRET=change-me-to-a-long-random-string

# Auth mode — set to 'true' on production to enable Shibboleth/JWT auth
# VITE_AUTH_ENABLED=true
