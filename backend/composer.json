{
    "name": "smith/folio-report-explorer",
    "description": "FOLIO Report Explorer — visual query builder and schema explorer",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "yiisoft/yii2": "~2.0.49",
        "yiisoft/yii2-httpclient": "~2.0",
        "npm-asset/jquery": "^3.7"
    },
    "require-dev": {
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-update-cmd": [
            "yii\\composer\\Installer::postUpdate"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {"runtime": "0777"},
                {"web/assets": "0777"}
            ],
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    }
}
