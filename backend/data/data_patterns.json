        "folio_source_record.records__t": {
            "columnWarnings": {
                "metadata__created_date": "NUMERIC type — epoch milliseconds, not a standard timestamp. Do not use DATE() or INTERVAL arithmetic directly; convert with: to_timestamp(metadata__created_date::bigint / 1000)",
                "metadata__updated_date": "NUMERIC type — epoch milliseconds, not a standard timestamp. Do not use DATE() or INTERVAL arithmetic directly; convert with: to_timestamp(metadata__updated_date::bigint / 1000)",
                "parsed_record__id": "TEXT type (UUID stored as text string, NOT a uuid type — do not cast or use uuid operators, join directly with =)",
                "external_ids_holder__instance_id": "TEXT type (UUID stored as text string, NOT a uuid type — do not cast or use uuid operators, join directly with =)",
                "parsed_record__content": "TEXT type containing JSON string content (NOT jsonb). Do NOT use ->, ->>, ?, ?|, ?& or @> directly. Prefer marctab for field-level queries; cast to ::jsonb only as a last resort."
            },
            "sampleValues": {
                "record_type": [
                    "MARC_BIB"
                ]
            },
            "preferredApproach": [
                "Contains the full MARC source record in parsed_record__content (JSON with 'leader' and 'fields' keys).",
                "Join to instances via: records__t.external_id = instance__t.id AND records__t.state = 'ACTUAL'.",
                "ALWAYS include parsed_record__content in SELECT when user asks for MARC record data, source records, full MARC, or raw MARC.",
                "For field-level MARC queries (check existence, extract subfield, filter by field value), prefer folio_source_record.marctab instead.",
                "Use records__t when user wants the complete record; use marctab when user wants specific fields.",
                "For MARC field-level queries (find by subject, title, ISBN, check field existence), ALWAYS use marctab.mtNNN tables — e.g. marctab.mt245 for title, marctab.mt300 for physical description. marctab tables are faster and avoid JSON.",
                "Use records__t ONLY for record-level status queries: checking deleted=true, additional_info__suppress_discovery, or record_type.",
                "NEVER use -> or ->> JSONB operators on parsed_record__content — it is a TEXT column. It stores a JSON string that must be cast with ::jsonb before JSON extraction, but prefer marctab over ever doing this.",
                "To find records MISSING a MARC field: LEFT JOIN marctab.mtNNN m ON m.instance_hrid = inst.hrid, then WHERE m.srs_id IS NULL.",
                "To join records__t to inventory: external_ids_holder__instance_id = inventory.instance__t.id (UUID stored as text)."
            ]
        },
